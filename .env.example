# Loopback by default. Set 0.0.0.0 only behind a firewall or auth you control.
RECALL_HOST=127.0.0.1
# Optional bearer token required by remember(). Use a file (mode 600) or env.
# RECALL_AUTH_TOKEN_FILE=/home/you/.config/fusional/recall-write-token
# RECALL_AUTH_TOKEN=
# docker-compose.yml mounts this host file into the container (use an absolute path):
# RECALL_AUTH_TOKEN_FILE_HOST=/home/you/.config/fusional/recall-write-token
RECALL_PORT=8107
RECALL_DB_PATH=./recall.db
EMBEDDING_MODEL=all-MiniLM-L6-v2
DEFAULT_TIER=personal
# Path to your SOLVED-ISSUES.md — auto-migrated on first startup
SOLVED_ISSUES_PATH=../fusional-knowledge-base/05-RECALL/SOLVED-ISSUES.md
